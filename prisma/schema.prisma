// Prisma Schema for BU Bigsize (Men & Women Plus-size E-Commerce, Rental & Makeup Services)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderItemType {
  BUY
  RENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  VIETQR
  VNPAY
  MOMO
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum FitFeedback {
  TOO_TIGHT
  SLIGHTLY_TIGHT
  PERFECT_FIT
  SLIGHTLY_LOOSE
  TOO_LOOSE
}

enum BookingLocationType {
  STUDIO
  AT_HOME
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id          String         @id @default(cuid())
  phone       String         @unique
  email       String?        @unique
  fullName    String
  role        Role           @default(CUSTOMER)
  gender      Gender?
  heightCm    Int?
  weightKg    Float?
  addresses   UserAddress[]
  orders      Order[]
  reviews     Review[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("users")
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient   String
  phone       String
  province    String
  district    String
  ward        String
  street      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("user_addresses")
}

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  name        String
  slug        String     @unique
  gender      Gender
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  products    Product[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model Occasion {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @db.Text
  subtitle    String?
  image       String?
  badge       String?
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("occasions")
}

model SizeGuide {
  id          String          @id @default(cuid())
  name        String
  gender      Gender
  note        String?
  items       SizeGuideItem[]
  products    Product[]

  @@map("size_guides")
}

model SizeGuideItem {
  id          String    @id @default(cuid())
  sizeGuideId String
  sizeGuide   SizeGuide @relation(fields: [sizeGuideId], references: [id], onDelete: Cascade)
  sizeLabel   String    // e.g. "2XL", "3XL"
  minWeightKg Float
  maxWeightKg Float
  minHeightCm Int
  maxHeightCm Int
  chestCm     String?
  waistCm     String?
  hipCm       String?
  lengthCm    String?

  @@map("size_guide_items")
}

model Product {
  id                   String           @id @default(cuid())
  categoryId           String
  category             Category         @relation(fields: [categoryId], references: [id])
  sizeGuideId          String?
  sizeGuide            SizeGuide?       @relation(fields: [sizeGuideId], references: [id])
  name                 String
  slug                 String           @unique
  gender               Gender
  basePrice            Decimal          @db.Decimal(12, 2)
  originalPrice        Decimal          @db.Decimal(12, 2)
  weightRecommendation String           // e.g. "55kg - 95kg" or "65kg - 130kg"
  description          String           @db.Text
  features             String[]
  isFeatured           Boolean          @default(false)
  status               String           @default("PUBLISHED")
  
  // Nghiệp vụ cho thuê & Dịp
  isRentable           Boolean          @default(true)
  rentalPrice          Decimal?         @db.Decimal(12, 2)
  rentalDeposit        Decimal?         @db.Decimal(12, 2)
  stylistTip           String?          @db.Text
  occasions            Occasion[]

  images               ProductImage[]
  variants             ProductVariant[]
  reviews              Review[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("products")
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl    String
  colorName   String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)

  @@map("product_images")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String      @unique
  colorName     String
  colorHex      String
  size          String
  price         Decimal     @db.Decimal(12, 2)
  originalPrice Decimal     @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  weightGrams   Int         @default(350)
  orderItems    OrderItem[]

  @@map("product_variants")
}

model Order {
  id                  String               @id @default(cuid())
  code                String               @unique // e.g. "BU-20261031-01"
  userId              String?
  user                User?                @relation(fields: [userId], references: [id])
  customerName        String
  customerPhone       String
  shippingAddress     String               @db.Text
  totalProductAmount  Decimal              @db.Decimal(12, 2)
  totalDepositAmount  Decimal              @db.Decimal(12, 2) @default(0) // Tiền cọc giữ đồ (hoàn trả 100%)
  shippingFee         Decimal              @db.Decimal(12, 2)
  discountAmount      Decimal              @db.Decimal(12, 2) @default(0)
  finalAmount         Decimal              @db.Decimal(12, 2)
  orderStatus         OrderStatus          @default(PENDING)
  paymentMethod       PaymentMethod        @default(COD)
  paymentStatus       PaymentStatus        @default(UNPAID)
  customerNote        String?              @db.Text
  bankRefundInfo      String?              // STK hoàn cọc
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  reviews             Review[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  productName     String
  colorName       String
  sizeName        String
  unitPrice       Decimal        @db.Decimal(12, 2)
  quantity        Int
  
  // Thuê sản phẩm
  itemType        OrderItemType  @default(BUY)
  rentalDays      Int?           // vd: 3 hoặc 5 ngày
  rentalStartDate DateTime?
  rentalEndDate   DateTime?
  deposit         Decimal?       @db.Decimal(12, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  createdAt   DateTime    @default(now())

  @@map("order_status_history")
}

model MakeupPackage {
  id            String          @id @default(cuid())
  name          String
  price         Decimal         @db.Decimal(12, 2)
  originalPrice Decimal?        @db.Decimal(12, 2)
  duration      String          // e.g. "45 - 60 phút"
  description   String          @db.Text
  features      String[]
  image         String
  tag           String?
  bookings      MakeupBooking[]
  createdAt     DateTime        @default(now())

  @@map("makeup_packages")
}

model MakeupBooking {
  id            String              @id @default(cuid())
  packageId     String
  package       MakeupPackage       @relation(fields: [packageId], references: [id])
  customerName  String
  customerPhone String
  bookingDate   DateTime
  timeSlot      String              // e.g. "09:30"
  locationType  BookingLocationType @default(STUDIO)
  address       String?             @db.Text
  notes         String?             @db.Text
  status        BookingStatus       @default(PENDING)
  createdAt     DateTime            @default(now())

  @@map("makeup_bookings")
}

model Review {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  orderId        String?
  order          Order?      @relation(fields: [orderId], references: [id])
  rating         Int         @default(5)
  fitFeedback    FitFeedback @default(PERFECT_FIT)
  customerHeight Int?
  customerWeight Float?
  purchasedSize  String
  comment        String      @db.Text
  images         String[]
  isApproved     Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@map("reviews")
}
